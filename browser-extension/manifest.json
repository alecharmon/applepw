{
  "manifest_version": 3,
  "name": "applepw Browser Bridge",
  "version": "0.1.0",
  "description": "Launch Apple's Passwords helper from a signed browser for the local applepw CLI.",
  "permissions": ["nativeMessaging"],
  "action": {"default_popup": "bridge.html"},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*"
  },
  "key": ""
}
